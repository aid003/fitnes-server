generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  COACH
}

enum DurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum BillingType {
  FIXED_TERM
  UNLIMITED
  SINGLE_VISIT
  VISIT_PACK
}

enum PassFeatureIcon {
  TICKET
  FLAME
  SNOWFLAKE
  CALENDAR
  GIFT
  DUMBBELL
  POOL
  COMBO
}

enum MembershipStatus {
  ACTIVE
  FROZEN
  EXPIRED
}

enum MembershipFreezeStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MembershipRenewalStatus {
  PENDING
  PROCESSED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  role                UserRole             @default(USER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailLoginChallenges EmailLoginChallenge[]
  memberships         UserMembership[]
  membershipRenewalRequests UserMembershipRenewalRequest[]
}

model EmailLoginChallenge {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, expiresAt])
  @@index([userId])
}

model PassCategory {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?
  coverImageUrl String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  variants      PassVariant[]

  @@index([isActive, sortOrder])
}

model PassVariant {
  id          String          @id @default(cuid())
  categoryId  String
  title       String
  slug        String
  description String?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    PassCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groups      PassPlanGroup[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

model PassPlanGroup {
  id          String       @id @default(cuid())
  variantId   String
  title       String
  slug        String
  description String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  variant     PassVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  plans       PassPlan[]

  @@unique([variantId, slug])
  @@index([variantId, isActive, sortOrder])
}

model PassPlan {
  id             String          @id @default(cuid())
  groupId         String
  title           String
  slug            String
  description     String?
  subtitle        String?
  price           Int
  currency        String          @default("RUB")
  durationValue   Int?
  durationUnit    DurationUnit?
  visitCount      Int?
  billingType     BillingType?
  highlightStyle  String?
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  group           PassPlanGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  badges          PassBadge[]
  features        PassFeature[]
  memberships     UserMembership[]

  @@unique([groupId, slug])
  @@index([groupId, isActive, sortOrder])
}

model UserMembership {
  id                    String                         @id @default(cuid())
  userId                String
  passPlanId            String
  title                 String
  subtitle              String?
  description           String?
  startsAt              DateTime
  endsAt                DateTime
  status                MembershipStatus              @default(ACTIVE)
  freezeDaysLimit       Int                            @default(0)
  freezeDaysUsed        Int                            @default(0)
  canRenew              Boolean                        @default(true)
  sortOrder             Int                            @default(0)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  passPlan              PassPlan                       @relation(fields: [passPlanId], references: [id], onDelete: Restrict)
  freezes               UserMembershipFreeze[]
  renewalRequests       UserMembershipRenewalRequest[]

  @@index([userId, status, startsAt])
  @@index([passPlanId])
}

model UserMembershipFreeze {
  id            String                  @id @default(cuid())
  membershipId  String
  startsAt      DateTime
  endsAt        DateTime
  daysUsed      Int
  status        MembershipFreezeStatus  @default(ACTIVE)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  membership    UserMembership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, status, startsAt])
}

model UserMembershipRenewalRequest {
  id            String                   @id @default(cuid())
  membershipId  String
  userId        String
  comment       String?
  status        MembershipRenewalStatus  @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  membership    UserMembership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([membershipId, status, createdAt])
  @@index([userId, status, createdAt])
}

model PassBadge {
  id          String    @id @default(cuid())
  planId       String
  label        String
  style        String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  plan         PassPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}

model PassFeature {
  id         String          @id @default(cuid())
  planId      String
  label       String
  icon        PassFeatureIcon
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  plan        PassPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}
