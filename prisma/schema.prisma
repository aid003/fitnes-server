generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  COACH
}

enum DurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum BillingType {
  FIXED_TERM
  UNLIMITED
  SINGLE_VISIT
  VISIT_PACK
}

enum PassFeatureIcon {
  TICKET
  FLAME
  SNOWFLAKE
  CALENDAR
  GIFT
  DUMBBELL
  POOL
  COMBO
}

enum MembershipStatus {
  PENDING_ACTIVATION
  ACTIVE
  FROZEN
  EXPIRED
  REFUNDED
}

enum MembershipFreezeStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MembershipRenewalStatus {
  PENDING
  PROCESSED
  CANCELLED
}

enum PaymentOrderStatus {
  CREATED
  FORM_REGISTERED
  REDIRECT_READY
  REDIRECTED
  PROCESSING
  PAID
  REFUNDED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentGatewayProvider {
  ALFA
  TBANK
}

enum PaymentOrderEventType {
  INIT_REQUEST
  INIT_RESPONSE
  GET_STATE_REQUEST
  GET_STATE_RESPONSE
  WEBHOOK_RECEIVED
  WEBHOOK_REJECTED
  REFUND_REQUEST
  REFUND_RESPONSE
  STATUS_SYNC
}

enum ScheduleWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EmailChallengePurpose {
  REGISTER
  PASSWORD_RECOVERY
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  phone               String?
  passwordHash        String
  role                UserRole             @default(USER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailLoginChallenges EmailLoginChallenge[]
  memberships         UserMembership[]
  membershipRenewalRequests UserMembershipRenewalRequest[]
  paymentOrders       PaymentOrder[]
  adBannerDismissals  UserAdBannerDismissal[]
  rememberSessions    RememberSession[]
}

model Trainer {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  role       String
  shortBio   String?
  photoUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder, name])
}

model NewsArticle {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  excerpt          String?
  coverImageUrl    String?
  lead             String?
  highlightsTitle  String?
  highlights       Json?
  contentRichText  String
  tags             Json?
  publishedAt      DateTime?
  sortOrder        Int      @default(0)
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isPublished, publishedAt, sortOrder])
}

model AdBanner {
  id                 String                  @id @default(cuid())
  title              String
  imageUrl           String?
  targetUrl          String
  startsAt           DateTime
  endsAt             DateTime
  repeatIntervalDays Int
  sortOrder          Int                     @default(0)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  dismissals         UserAdBannerDismissal[]

  @@index([isActive, startsAt, endsAt, sortOrder])
}

model UserAdBannerDismissal {
  id         String   @id @default(cuid())
  userId     String
  bannerId   String
  dismissedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner      AdBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([userId, bannerId])
  @@index([bannerId, dismissedAt])
}

model EmailLoginChallenge {
  id         String                @id @default(cuid())
  email      String
  purpose    EmailChallengePurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  lastSentAt DateTime
  attempts   Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  userId     String?
  user       User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, purpose])
  @@index([email, expiresAt])
  @@index([userId])
}

model RememberSession {
  id         String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model PassCategory {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?
  coverImageUrl String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  variants      PassVariant[]

  @@index([isActive, sortOrder])
}

model PassVariant {
  id          String          @id @default(cuid())
  categoryId  String
  title       String
  slug        String
  description String?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    PassCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groups      PassPlanGroup[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

model PassPlanGroup {
  id          String       @id @default(cuid())
  variantId   String
  title       String
  slug        String
  description String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  variant     PassVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  plans       PassPlan[]

  @@unique([variantId, slug])
  @@index([variantId, isActive, sortOrder])
}

model PassPlan {
  id             String          @id @default(cuid())
  groupId         String
  title           String
  slug            String
  description     String?
  subtitle        String?
  /// Canonical plan price in kopecks.
  price           Int
  currency        String          @default("RUB")
  durationValue   Int?
  durationUnit    DurationUnit?
  visitCount      Int?
  billingType     BillingType?
  highlightStyle  String?
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  group           PassPlanGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  badges          PassBadge[]
  features        PassFeature[]
  memberships     UserMembership[]
  paymentOrders   PaymentOrder[]

  @@unique([groupId, slug])
  @@index([groupId, isActive, sortOrder])
}

model UserMembership {
  id                    String                         @id @default(cuid())
  userId                String
  passPlanId            String
  title                 String
  subtitle              String?
  description           String?
  issuedAt              DateTime                       @default(now())
  activatedAt           DateTime?
  startsAt              DateTime
  endsAt                DateTime
  status                MembershipStatus              @default(ACTIVE)
  billingType           BillingType?
  durationValue         Int?
  durationUnit          DurationUnit?
  totalVisits           Int?
  usedVisits            Int                            @default(0)
  freezeDaysLimit       Int                            @default(0)
  freezeDaysUsed        Int                            @default(0)
  canRenew              Boolean                        @default(true)
  sortOrder             Int                            @default(0)
  qrPayload             Json?
  qrSignature           String?
  qrCodeSvg             String?
  qrGeneratedAt         DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  passPlan              PassPlan                       @relation(fields: [passPlanId], references: [id], onDelete: Restrict)
  freezes               UserMembershipFreeze[]
  renewalRequests       UserMembershipRenewalRequest[]
  paymentOrders         PaymentOrder[]

  @@index([userId, status, startsAt])
  @@index([userId, issuedAt])
  @@index([passPlanId])
}

model UserMembershipFreeze {
  id            String                  @id @default(cuid())
  membershipId  String
  startsAt      DateTime
  endsAt        DateTime
  daysUsed      Int
  status        MembershipFreezeStatus  @default(ACTIVE)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  membership    UserMembership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, status, startsAt])
}

model UserMembershipRenewalRequest {
  id            String                   @id @default(cuid())
  membershipId  String
  userId        String
  comment       String?
  status        MembershipRenewalStatus  @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  membership    UserMembership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([membershipId, status, createdAt])
  @@index([userId, status, createdAt])
}

model PaymentOrder {
  id                    String             @id @default(cuid())
  userId                String
  passPlanId            String
  membershipId          String?
  gatewayProvider       PaymentGatewayProvider @default(ALFA)
  merchantOrderNumber   String             @unique
  gatewayOrderId        String?            @unique
  gatewayPaymentId      String?            @unique
  /// Canonical payment amount in kopecks.
  amount                Int
  currency              String             @default("RUB")
  status                PaymentOrderStatus @default(CREATED)
  gatewayOrderStatus    Int?
  gatewayPaymentState   String?
  gatewayStatus         String?
  gatewayErrorCode      String?
  gatewayMessage        String?
  gatewayDetails        String?
  actionCode            Int?
  actionCodeDescription String?
  formUrl               String?
  paymentUrl            String?
  returnUrl             String
  failUrl               String
  planTitle             String
  planSubtitle          String?
  planDescription       String?
  payerEmail            String?
  payerPhone            String?
  fiscalPayload         Json?
  receiptPayload        Json?
  refundedAmount        Int                @default(0)
  notificationTokenValid Boolean?
  lastNotificationAt    DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  redirectedAt          DateTime?
  paidAt                DateTime?
  failedAt              DateTime?
  refundedAt            DateTime?
  membershipIssuedAt    DateTime?
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  passPlan              PassPlan           @relation(fields: [passPlanId], references: [id], onDelete: Restrict)
  membership            UserMembership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  events                PaymentOrderEvent[]

  @@index([userId, createdAt])
  @@index([passPlanId, createdAt])
  @@index([status, createdAt])
  @@index([gatewayProvider, createdAt])
  @@index([gatewayPaymentId])
  @@index([gatewayStatus, createdAt])
}

model PaymentOrderEvent {
  id             String                @id @default(cuid())
  paymentOrderId String
  type           PaymentOrderEventType
  gatewayStatus  String?
  success        Boolean?
  errorCode      String?
  message        String?
  payload        Json?
  createdAt      DateTime              @default(now())
  paymentOrder   PaymentOrder          @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([paymentOrderId, createdAt])
  @@index([type, createdAt])
}

model ScheduleTemplateSlot {
  id              String          @id @default(cuid())
  weekday         ScheduleWeekday
  title           String
  startTime       String
  endTime         String
  ageBadge        String?
  secondaryBadge  String?
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([weekday, isActive, sortOrder, startTime])
}

model PassBadge {
  id          String    @id @default(cuid())
  planId       String
  label        String
  style        String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  plan         PassPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}

model PassFeature {
  id         String          @id @default(cuid())
  planId      String
  label       String
  icon        PassFeatureIcon
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  plan        PassPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}
